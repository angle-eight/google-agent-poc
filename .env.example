# local: ローカルADK + Googleモデル / remote: Agent Runtime
APP_BACKEND=local
GOOGLE_CLOUD_PROJECT=your-project-id
# Agent RuntimeのリージョンとGeminiのエンドポイントは別々に設定する
GOOGLE_CLOUD_LOCATION=us-central1
MODEL_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.5-flash

# オブジェクト方式のAgent Runtimeデプロイに必要
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-project-id-agent-staging
# デプロイ結果に出力される完全なリソース名
AGENT_ENGINE_RESOURCE_NAME=
# remoteモードで必須。uv run python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=
# Cloud Runへデプロイする際はtrue。ローカルのHTTP/proxyではfalse
COOKIE_SECURE=false

# 任意: Agent Runtime用のカスタムサービスアカウント
AGENT_SERVICE_ACCOUNT=
